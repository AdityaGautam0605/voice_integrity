listening-port=@TURN_PORT@
tls-listening-port=@TURN_TLS_PORT@
listening-ip=@RELAY_IPV4@
relay-ip=@RELAY_IPV4@
external-ip=@PUBLIC_IPV4@/@RELAY_IPV4@
min-port=49160
max-port=49260
realm=@TURN_HOST@
server-name=@TURN_HOST@
fingerprint
use-auth-secret
static-auth-secret=@TURN_SECRET@
cert=/etc/voice-integrity/tls/fullchain.pem
pkey=/etc/voice-integrity/tls/privkey.pem
no-tlsv1
no-tlsv1_1
no-dtls
no-cli
no-multicast-peers
no-tcp-relay
no-rfc5780
no-stun-backward-compatibility
user-quota=12
total-quota=48
max-bps=128000
bps-capacity=3000000
stale-nonce=600
pidfile=/tmp/turnserver.pid
log-file=stdout
simple-log
# Block relay access to local, private, multicast and reserved destinations.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
