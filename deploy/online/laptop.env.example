# Copy to .env.online at the repository root; chmod 600 .env.online.
# The public frontend and coturn must be deployed using deploy/online first.
VIF_PUBLIC_ORIGIN=https://demo.example.com
VIF_TURN_HOST=turn.example.com
VIF_TURN_SECRET=replace-with-the-same-random-secret-used-on-the-vps
VIF_TURN_PORT=3478
VIF_TURN_TLS_PORT=5349
# Dedicated restricted account or an existing SSH config alias.
VIF_SSH_HOST=vif-tunnel@your-vps
# Optional overrides. Otherwise SSH uses your usual config and known_hosts.
# VIF_SSH_PORT=2222
# VIF_SSH_KEY=~/.ssh/vif-demo
# VIF_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
VIF_BACKEND=stub
VIF_DEMO_SCENARIOS=1
VIF_VAD=energy
# A fresh operator code is generated at each startup by default.
