# VPS only. Copy to .env, chmod 600 .env, then replace every example value.
# These are plain values. No shell expansion or interpolation is performed.
DEMO_HOST=demo.example.com
TURN_HOST=turn.example.com
PUBLIC_IPV4=203.0.113.10
# Use PUBLIC_IPV4 here when that address belongs to a VPS interface.
# For a provider's 1:1 NAT, use the VPS's private interface IPv4 instead.
RELAY_IPV4=203.0.113.10
CERTBOT_EMAIL=you@example.com
# Generate once: openssl rand -hex 32
# This must exactly equal the laptop VIF_TURN_SECRET.
TURN_SECRET=replace-with-the-same-random-secret-used-on-the-laptop
TURN_PORT=3478
TURN_TLS_PORT=5349
