# Copy to .env.tunnel in the repository root (chmod 600).
# App domain from Metered, without https:// or a path.
VIF_METERED_DOMAIN=your-app.metered.live
# TURN Server -> Add Credential -> that credential's API key.
# This is NOT the app-wide Secret Key on the Developers page.
# Create it at least two minutes before a rehearsal.
VIF_METERED_API_KEY=
VIF_BACKEND=stub
VIF_DEMO_SCENARIOS=1
VIF_VAD=energy
# Optional: full path if cloudflared is not on PATH.
# VIF_CLOUDFLARED=/opt/homebrew/bin/cloudflared
# A new operator sign-in code and public HTTPS URL are generated at startup.
